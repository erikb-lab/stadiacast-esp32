# Overlay for No-PSRAM ESP32-S3 boards (512 KB Internal SRAM, 4MB+ Flash)
# Examples: LilyGO T-Dongle-S3 (Standard), M5Stack AtomS3U, M5Stack StampS3, Adafruit QT Py S3 (No-PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_OPUS_PSEUDOSTACK_SIZE=60000
CONFIG_OPUS_STATE_PREFER_INTERNAL=y
CONFIG_OPUS_PSEUDOSTACK_PREFER_INTERNAL=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=n
