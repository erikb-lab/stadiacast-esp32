# Overlay for 4MB+ Flash + 2MB Quad (QSPI) PSRAM ESP32-S3 boards (ESP32-S3FH4R2 / N8R2)
# Examples: Waveshare ESP32-S3-Zero, ESP32-S3 SuperMini, Wemos Lolin S3 Mini, Adafruit QT Py S3 (PSRAM), Waveshare S3-GEEK
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_SPIRAM_MODE_OCT=n
CONFIG_SPIRAM_MODE_QUAD=y
